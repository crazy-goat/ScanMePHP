{
    "name": "crazy-goat/scanmephp",
    "description": "Pure PHP QR code generator with zero dependencies",
    "type": "composer-plugin",
    "keywords": [
        "qr",
        "qrcode",
        "barcode",
        "generator",
        "php"
    ],
    "homepage": "https://github.com/crazy-goat/ScanMePHP",
    "license": "MIT",
    "authors": [
        {
            "name": "Crazy Goat",
            "email": "crazy@goat.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "composer-plugin-api": "^2.0"
    },
    "require-dev": {
        "ext-gd": "*",
        "brianium/paratest": "^7.6",
        "composer/composer": "^2",
        "friendsofphp/php-cs-fixer": "^3",
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2"
    },
    "autoload": {
        "psr-4": {
            "CrazyGoat\\ScanMePHP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CrazyGoat\\ScanMePHP\\Tests\\": "tests/"
        }
    },
    "extra": {
        "class": "CrazyGoat\\ScanMePHP\\Composer\\Plugin"
    },
    "scripts": {
        "test": "phpunit",
        "test:fast": "php -d xdebug.mode=off vendor/bin/phpunit",
        "test:parallel": "paratest --processes=4 --colors --testdox",
        "lint": [
            "@lint:cs",
            "@lint:phpstan",
            "@lint:rector",
            "@lint:kb"
        ],
        "lint-fix": [
            "@lint:cs-fix",
            "@lint:rector-fix",
            "@lint:kb-fix"
        ],
        "lint:cs": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "lint:cs-fix": "php-cs-fixer fix --allow-risky=yes",
        "lint:phpstan": "phpstan analyse --memory-limit=512M",
        "lint:rector": "rector process --dry-run",
        "lint:rector-fix": "rector process",
        "lint:kb": "php bin/kb-lint.php",
        "lint:kb-fix": "php bin/kb-lint.php --fix",
        "decoders:install": [
            "python3 -m venv .decoders",
            ".decoders/bin/pip install --quiet --upgrade pip",
            ".decoders/bin/pip install --quiet zxing-cpp pillow qrcodegen"
        ],
        "test:roundtrip": "php -d xdebug.mode=off vendor/bin/phpunit --no-coverage tests/DecoderRoundTripTest.php",
        "reference:ean-upc": ".decoders/bin/python tools/ean_upc_reference.py",
        "reference:code39": ".decoders/bin/python tools/code39_reference.py",
        "reference:code93": ".decoders/bin/python tools/code93_reference.py",
        "reference:itf": ".decoders/bin/python tools/itf_reference.py",
        "reference:codabar": ".decoders/bin/python tools/codabar_reference.py",
        "reference:code128": ".decoders/bin/python tools/code128_reference.py",
        "reference:gs1": ".decoders/bin/python tools/gs1_reference.py",
        "reference:gs1-qr": ".decoders/bin/python tools/gs1_qr_reference.py",
        "reference:qr": ".decoders/bin/python tools/qr_reference.py",
        "reference:qr-agreement": "php tools/qr_agreement_fixture.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "decoders:install": "Install the reference decoder and encoders the verification suite compares against",
        "test:roundtrip": "Verify every symbology against an independent barcode decoder",
        "reference:ean-upc": "Regenerate the EAN/UPC module patterns from zxing-cpp"
    }
}

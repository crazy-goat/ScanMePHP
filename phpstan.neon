includes:
    - phpstan-baseline.neon

parameters:
    level: 4
    # Analyse the whole range composer.json promises (^8.2), not whichever
    # interpreter happens to run the tool. Without this a maintainer on 8.5
    # and CI on 8.2 get different answers from the same command, and the gate
    # is only worth having if it says one thing.
    phpVersion:
        min: 80200
        max: 80400
    paths:
        - src/
        - tests/
        - bin/
        - examples/
        - bench/
    excludePaths:
        analyseAndScan:
            - clib/*
            - vendor/*
            - php-ext/*
            # FFI boundary: conditional if/else class swap + dynamic C struct/methods
            # via FFI::cdef — PHPStan cannot resolve these statically.
            - src/NativeEncoder.php
            - src/FfiEncoder.php
